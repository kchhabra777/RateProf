generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  passwordHash      String
  role              Role
  detectedBatch     String?
  isEmailVerified   Boolean         @default(false)
  isProfileComplete Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  isBanned          Boolean         @default(false)
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  rollNumber  String   @unique
  branch      String
  batch       String
  yearOfStudy Int
  isCR        Boolean  @default(false)
  xp          Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fullName    String?
  selectedElectives String[] @default([])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([xp(sort: Desc)])
  @@index([batch, branch])
}

model TeacherProfile {
  id          String           @id @default(uuid())
  userId      String           @unique
  fullName    String
  department  String
  designation String
  roomNumber  String?
  linkedIn    String?
  photoUrl    String?
  thaparProfileUrl String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  offerings   CourseOffering[]
  suggestions TeacherNameSuggestion[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourseOffering {
  id           String         @id @default(uuid())
  teacherId    String
  courseCode   String
  courseName   String
  batchTaught  String
  branchTaught String
  academicYear String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  ltp          String         @default("L")
  isElective   Boolean        @default(false)
  isArchived   Boolean        @default(false)
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([batchTaught, branchTaught])
  @@index([teacherId])
  @@index([courseCode])
  @@index([isElective])
}

model Review {
  reviewId       Int           @id @default(autoincrement())
  reviewerId     String
  revieweeId     String
  rating         Int
  reviewText     String
  context        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isFlagged      Boolean       @default(false)
  courseCode     String?
  courseName     String?
  reviewerBatch  String?
  reviewerBranch String?
  reviewerRollNo String?
  reviewerEmail  String?
  reviewerName   String?
  tags           String[]      @default([])
  flags          ReviewFlag[]
  replies        ReviewReply[]
  votes          ReviewVote[]

  @@index([revieweeId])
  @@index([reviewerId])
  @@index([reviewerId, revieweeId, courseCode])
  @@index([revieweeId, isFlagged])
  @@index([createdAt])
}

model ReviewVote {
  voteId    Int      @id @default(autoincrement())
  reviewId  Int
  userId    String
  voteType  VoteType
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model ReviewFlag {
  flagId     Int        @id @default(autoincrement())
  reviewId   Int
  reporterId String
  reason     String
  status     FlagStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  review     Review     @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)

  @@index([reviewId, status])
  @@index([reporterId])
}

model ReviewReply {
  replyId       Int           @id @default(autoincrement())
  reviewId      Int
  authorId      String
  authorRole    Role
  authorName    String
  authorBadge   String?
  replyText     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  parentReplyId Int?
  votes         ReplyVote[]
  parentReply   ReviewReply?  @relation("ThreadedReplies", fields: [parentReplyId], references: [replyId], onDelete: Cascade)
  childReplies  ReviewReply[] @relation("ThreadedReplies")
  review        Review        @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)
}

model ReplyVote {
  voteId    Int         @id @default(autoincrement())
  replyId   Int
  userId    String
  voteType  VoteType
  createdAt DateTime    @default(now())
  reply     ReviewReply @relation(fields: [replyId], references: [replyId], onDelete: Cascade)

  @@unique([replyId, userId])
}

model ProfileRating {
  ratingId      Int      @id @default(autoincrement())
  userId        String   @unique
  overallRating Float
  totalReviews  Int
  calculatedAt  DateTime @default(now())
  recentRating  Float
}

model CommunityTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  type      String
  opposite  String?
  createdAt DateTime @default(now())
}

model TeacherNameSuggestion {
  id                  String         @id @default(uuid())
  teacherId           String?
  suggestedName       String?
  suggestedDept       String?
  suggestedCourseCode String?
  suggestedCourseName String?
  suggestedLtp        String?        // L, T, P
  suggestedBatchTaught String?
  suggestedBranchTaught String?
  courseOfferingId    String?
  suggestedRoomNo     String?
  suggestedLinkedIn   String?
  suggestedPhotoUrl   String?
  suggestedThaparProfileUrl String?
  notes               String?
  studentId           String
  studentRollNo       String?
  studentEmail        String?
  isCR                Boolean        @default(false)
  batch               String?
  status              String         @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt           DateTime       @default(now())
  teacher             TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model BatchChangeRequest {
  id             String   @id @default(uuid())
  studentId      String
  studentRollNo  String
  studentName    String?
  currentBatch   String
  requestedBatch String
  currentBranch  String?
  requestedBranch String?
  reason         String?
  crId           String?
  crEmail        String?
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum VoteType {
  UP
  DOWN
}

enum FlagStatus {
  PENDING
  REVIEWED
  DISMISSED
  REMOVED
}
